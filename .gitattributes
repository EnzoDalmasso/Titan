# ============================================================
# Finales de línea
# Todo archivo de texto se guarda y se descarga con LF, sin importar
# el core.autocrlf de cada PC. Así Windows y cualquier otra máquina
# ven exactamente los mismos bytes y no aparecen diffs fantasma.
# Visual Studio, Rider y Unity trabajan sin problemas con LF.
# ============================================================
* text=auto eol=lf

# Scripts que Windows solo ejecuta bien con CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Los hooks y scripts de shell los ejecuta Git Bash: deben ser LF.
*.sh        text eol=lf
.githooks/* text eol=lf

# Código C# con diff que entiende métodos y clases.
*.cs    text diff=csharp

# ============================================================
# Archivos YAML de Unity (Force Text)
# merge=unityyamlmerge le indica a Git que use Smart Merge en estos
# archivos. Cómo registrar la herramienta en cada PC: ver README.
# ============================================================
*.unity               text merge=unityyamlmerge
*.prefab              text merge=unityyamlmerge
*.asset               text merge=unityyamlmerge
*.meta                text merge=unityyamlmerge
*.mat                 text merge=unityyamlmerge
*.anim                text merge=unityyamlmerge
*.controller          text merge=unityyamlmerge
*.overrideController  text merge=unityyamlmerge
*.mask                text merge=unityyamlmerge
*.playable            text merge=unityyamlmerge
*.physicMaterial      text merge=unityyamlmerge
*.physicsMaterial2D   text merge=unityyamlmerge
*.preset              text merge=unityyamlmerge
*.lighting            text merge=unityyamlmerge
*.mixer               text merge=unityyamlmerge
*.renderTexture       text merge=unityyamlmerge
*.spriteatlas         text merge=unityyamlmerge
*.terrainlayer        text merge=unityyamlmerge
*.shadervariants      text merge=unityyamlmerge
*.fontsettings        text merge=unityyamlmerge
*.guiskin             text merge=unityyamlmerge
*.flare               text merge=unityyamlmerge
*.giparams            text merge=unityyamlmerge
*.brush               text merge=unityyamlmerge

# Unity guarda los datos de iluminación horneada en binario aunque
# usemos Force Text.
**/LightingData.asset filter=lfs diff=lfs merge=lfs -text

# ============================================================
# Git LFS: binarios
# Git guarda un puntero de pocos bytes y el archivo real va al
# almacenamiento LFS. Sin esto, cada versión de una textura queda
# para siempre en el historial y el clon pesa cada vez más.
# ============================================================

# Imágenes y texturas
*.png   filter=lfs diff=lfs merge=lfs -text
